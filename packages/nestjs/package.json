{
  "name": "@cassandra-orm/nestjs",
  "version": "0.1.0",
  "description": "NestJS integration for @cassandra-orm/core",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karaa1122/cassandra-orm.git",
    "directory": "packages/nestjs"
  },
  "keywords": [
    "nestjs",
    "nest",
    "cassandra",
    "orm",
    "typescript"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@cassandra-orm/core": "workspace:^",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "cassandra-driver": "^4.7.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@cassandra-orm/core": "workspace:^",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/testing": "^12.1.3",
    "cassandra-driver": "^4.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
