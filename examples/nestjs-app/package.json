{
  "name": "@cassandra-orm/example-nestjs-app",
  "private": true,
  "description": "Chat-style NestJS app built on @cassandra-orm/nestjs",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "cassandra:up": "docker compose up -d --wait",
    "cassandra:down": "docker compose down"
  },
  "dependencies": {
    "@cassandra-orm/core": "workspace:*",
    "@cassandra-orm/nestjs": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "cassandra-driver": "^4.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
